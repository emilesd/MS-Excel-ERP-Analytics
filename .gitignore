# .NET build output
bin/
obj/
publish/

# IDE
.vs/
*.user
*.suo

# OS
Thumbs.db
.DS_Store

# Runtime SQLite database (per-user, never committed)
*.db
*.db-shm
*.db-wal

# Excel add-in runtime / staging (rebuilt by LaunchMyOlap.bat)
/AddIn/
/Deployed/

# Large or sensitive test fixtures (kept locally only)
TestData/Sales_Data ERP.xlsx
TestData/Backup/

# Installer build artifacts (regenerated by Packaging/build-installer.ps1)
/Packaging/payload/*
!/Packaging/payload/Install-Notes.txt
/Packaging/prereq/
/Packaging/output/
/Packaging/*.log
/Packaging/open-key-backup.txt

# Source snapshots handed to third parties
/Dist/

# Agent/editor local settings
.claude/

# Private notes, meeting logs, chat transcripts, internal feedback drafts
chattinglog.md
chatting_history.md
cursor_chattinglog.md
latestChattingLog.md
meetinglog.md
meetinglog-*.txt
*-meeting.txt
CurrentUpdateReuqirements.txt
JobPostAndChattinglog.txt
feedback-copy.pdf
MyOlap - Product Notes v1.2.pdf
MyOlap - Feedback Updates and Fixes.pdf

# Internal document archive (contains non-product personal files)
/Docs/Archive/

# Root-level scratch artifacts (screenshots, dev logs, completion markers)
/*.png
/*_done.txt
/*_log*.txt
/ui_results*.txt
/temp_*.txt
/MyOlap_SelfTest_*.pdf
/dbquery.cs
/query.csx
