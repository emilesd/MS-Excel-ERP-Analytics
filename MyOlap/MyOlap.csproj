<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ExcelDnaPack>true</ExcelDnaPack>
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <Product>MyOlap</Product>
    <Company>GoLive Systems</Company>
  </PropertyGroup>

  <Target Name="CopyPackedXllToAddIn" AfterTargets="ExcelDnaPack" Condition="'$(Configuration)'=='Release'">
    <Copy SourceFiles="$(OutDir)publish\MyOlap-AddIn64-packed.xll" DestinationFolder="C:\MyOlap\AddIn" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="$(OutDir)runtimes\win-x64\native\e_sqlite3.dll" DestinationFolder="C:\MyOlap\AddIn" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="$(OutDir)MyOlap.deps.json"        DestinationFolder="C:\MyOlap\AddIn" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="$(OutDir)MyOlap-AddIn.deps.json"  DestinationFolder="C:\MyOlap\AddIn" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="$(OutDir)MyOlap-AddIn64.deps.json" DestinationFolder="C:\MyOlap\AddIn" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
    <!-- Remove Zone.Identifier ADS so Excel doesn't show "format doesn't match extension" warning -->
    <Exec Command="powershell -Command &quot;Unblock-File -Path 'C:\MyOlap\AddIn\MyOlap-AddIn64-packed.xll'&quot;" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="EPPlus" Version="8.5.0" />
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.13" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
    <PackageReference Include="Svg" Version="3.4.7" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Ribbon\move-to-row-fluent.svg" />
    <EmbeddedResource Include="Ribbon\move-to-column-fluent.svg" />
    <EmbeddedResource Include="Ribbon\move-to-header-fluent.svg" />
  </ItemGroup>

</Project>
